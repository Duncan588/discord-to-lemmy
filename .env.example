# Public host:port users/browsers use to reach Lemmy (no scheme)
LEMMY_HOST=lemmy.example.lan:8536
LEMMY_PORT=8536
ADMIN_USER=admin
ADMIN_PW=change-me-strong-password
PG_PW=change-me-random-hex
PICTRS_API_KEY=change-me-random-hex
# Import options
GUILD_ID=
CATEGORY_ID=
THREAD_LIMIT=500
COMMUNITY_NAME=discord
COMMUNITY_TITLE=Discord archive
# Comma-separated Discord user IDs to exclude entirely (optional)
BLACKLIST_IDS=
# Optional portal.db with a global_blacklist(user_id) table
PORTAL_DB=data/portal.db
SOURCE_DB=data/discord_data.db
# Optional restic restore (see restore.sh)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_SQL_PATH=/discord_data-GUILD_ID.sql
